generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum SourceType {
  WEBSITE
  RSS
  FACEBOOK
  INSTAGRAM
  OTHER
}

enum SourceStatus {
  ACTIVE
  ERROR
  DISABLED
}

enum ContentCategory {
  POSITIVE
  NEUTRAL
  CRITICISM
  COMPLAINT
  ALLEGATION
  DENUNCIA
  SCANDAL
  OTHER_RELEVANT
  IRRELEVANT
}

enum Severity {
  LOW
  MEDIUM
  HIGH
}

enum ClaimType {
  FACT
  REPORTED_CLAIM
  OPINION
  ALLEGATION
  DENIAL
  UNVERIFIED
}

enum AnalysisStatus {
  PENDING
  COMPLETED
  FAILED
}

enum NotificationChannel {
  WHATSAPP
  EMAIL
}

enum NotificationStatus {
  PENDING
  SENT
  FAILED
}

model Source {
  id                String       @id @default(cuid())
  name              String
  type              SourceType
  url               String
  status            SourceStatus @default(ACTIVE)
  lastRunAt         DateTime?
  lastPublicationAt DateTime?
  lastError         String?      @db.Text
  publicationsCount Int          @default(0)
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  publications Publication[]
}

model MonitoredEntity {
  id        String   @id @default(cuid())
  name      String
  aliases   String[] @default([])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  publicationEntities PublicationEntity[]
  alerts              Alert[]
}

model ReviewRun {
  id Int @id @default(autoincrement())
  startedAt DateTime @default(now())
  publications Publication[]
}

model Publication {
  id           String    @id @default(cuid())
  sourceId     String
  source       Source    @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  externalId   String?
  title        String
  content      String    @db.Text
  url          String
  canonicalUrl String?
  contentHash  String    @unique
  publishedAt  DateTime?
  images       Json?
  createdAt    DateTime  @default(now())
  reviewRunId  Int?
  reviewRun    ReviewRun? @relation(fields: [reviewRunId], references: [id], onDelete: SetNull)

  entities PublicationEntity[]
  analysis Analysis?
  alerts   Alert[]

  @@unique([sourceId, externalId])
  @@index([url])
  @@index([reviewRunId])
}

model PublicationEntity {
  id            String          @id @default(cuid())
  publicationId String
  publication   Publication     @relation(fields: [publicationId], references: [id], onDelete: Cascade)
  entityId      String
  entity        MonitoredEntity @relation(fields: [entityId], references: [id], onDelete: Cascade)
  confidence    Float

  @@unique([publicationId, entityId])
}

model Analysis {
  id            String           @id @default(cuid())
  publicationId String           @unique
  publication   Publication      @relation(fields: [publicationId], references: [id], onDelete: Cascade)
  status        AnalysisStatus   @default(PENDING)
  relevant      Boolean?
  category      ContentCategory?
  severity      Severity?
  confidence    Float?
  summary       String?          @db.Text
  reason        String?          @db.Text
  claims        Json?
  rawOutput     Json?
  error         String?
  createdAt     DateTime         @default(now())

  alert Alert?
}

model Alert {
  id            String   @id @default(cuid())
  analysisId    String   @unique
  analysis      Analysis @relation(fields: [analysisId], references: [id], onDelete: Cascade)
  publicationId String
  publication   Publication     @relation(fields: [publicationId], references: [id], onDelete: Cascade)
  entityId      String
  entity        MonitoredEntity @relation(fields: [entityId], references: [id], onDelete: Cascade)
  category      ContentCategory
  severity      Severity
  confidence    Float
  summary       String   @db.Text
  createdAt     DateTime @default(now())

  notifications Notification[]
}

model Notification {
  id        String              @id @default(cuid())
  alertId   String
  alert     Alert               @relation(fields: [alertId], references: [id], onDelete: Cascade)
  channel   NotificationChannel
  status    NotificationStatus  @default(PENDING)
  error     String?
  sentAt    DateTime?
  createdAt DateTime            @default(now())
}
