# MySQL (docker-compose)
MYSQL_USER=scrapping
MYSQL_PASSWORD=scrapping
MYSQL_ROOT_PASSWORD=scrapping
MYSQL_DATABASE=scrapping
MYSQL_PORT=3306

DATABASE_URL=mysql://root:scrapping@localhost:3306/scrapping

# Backend (3200, no 3000: PostScope usa el 3000 por defecto — apps/postscope)
PORT=3200

# Frontend (Vite solo expone las variables con prefijo VITE_)
VITE_API_BASE_URL=http://localhost:3200

# IA (DeepSeek — https://api-docs.deepseek.com)
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-flash

# Reglas de alerta (backend decide, la IA solo propone)
ALERT_CATEGORIES=DENUNCIA,ALLEGATION,SCANDAL
ALERT_MIN_CONFIDENCE=0.7

# SendPulse / WhatsApp
SENDPULSE_API_KEY=
SENDPULSE_API_SECRET=
WHATSAPP_TARGET_NUMBER=

# Email (opcional)
EMAIL_FROM=
EMAIL_TO=
