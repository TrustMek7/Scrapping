# PostgreSQL (docker-compose)
POSTGRES_USER=scrapping
POSTGRES_PASSWORD=scrapping
POSTGRES_DB=scrapping
POSTGRES_PORT=5433

DATABASE_URL=postgresql://scrapping:scrapping@localhost:5433/scrapping

# Backend (3200, no 3000: PostScope usa el 3000 por defecto — apps/postscope)
PORT=3200

# Frontend (Vite solo expone las variables con prefijo VITE_)
VITE_API_BASE_URL=http://localhost:3200

# IA (DeepSeek — https://api-docs.deepseek.com)
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-flash

# Reglas de alerta (backend decide, la IA solo propone)
ALERT_CATEGORIES=POSITIVE,NEUTRAL,CRITICISM,COMPLAINT,ALLEGATION,DENUNCIA,SCANDAL,OTHER_RELEVANT
ALERT_MIN_CONFIDENCE=0.6

# SendPulse / WhatsApp
SENDPULSE_API_KEY=
SENDPULSE_API_SECRET=
WHATSAPP_TARGET_NUMBER=

# Email (opcional)
EMAIL_FROM=
EMAIL_TO=
